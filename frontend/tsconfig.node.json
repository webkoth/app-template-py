{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // vitest.config.ts тоже проверяется типами: без него tsc -b этот файл не
  // видит вовсе, и опечатка в конфиге тестов проходит мимо `make check`.
  // Команда смены темы живёт не здесь, а в tsconfig.app.json: она импортирует
  // модули из src, а этот конфиг требует у относительных импортов явного
  // расширения .js — то есть заставил бы дописать его и в скопированном
  // lib/design, разведя два шаблона на ровном месте.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
