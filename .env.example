# Локальная разработка. На контуре этот файл пишет app-provision.
DATABASE_URL="postgresql://apptemplatepy:apptemplatepy@localhost:5432/apptemplatepy_dev"
APP_ENV="local"
# openssl rand -hex 32
APP_AUTH_SECRET=""
COOKIE_SECURE="false"

# Отдельная база под e2e: тесты меняют данные.
DATABASE_URL_E2E="postgresql://apptemplatepy:apptemplatepy@localhost:5432/apptemplatepy_e2e"

# Первая учётная запись. Заводится только при пустой таблице пользователей.
# Пустое значение логина или пароля выключает создание.
APP_BOOTSTRAP_LOGIN="admin"
APP_BOOTSTRAP_PASSWORD="admin"
APP_BOOTSTRAP_NAME="Администратор"

# --- слой данных ---
# Каталог загрузок. Строка закомментирована: умолчание — uploads/ в корне
# репозитория (он потому и вписан в .gitignore). Путь обязан быть
# АБСОЛЮТНЫМ, иначе приложение не поднимется: относительный считается от
# рабочего каталога, а у приложения, воркера и команд make он разный —
# файл, загруженный минуту назад, оказался бы «не найден». Раскомментируя
# на контуре, подставь настоящий слаг вместо <слаг>.
# Каталога провижинер не заводит: его создаёт приложение при первой загрузке.
# UPLOAD_DIR="/var/www/<слаг>/uploads"
UPLOAD_MAX_BYTES="33554432"

# Очередь фоновых задач. STALE обязан быть ВТРОЕ больше HEARTBEAT: запас
# должен переживать пропущенную отметку живости, иначе задачу отбирают у
# работающего воркера. Попыток не больше десяти.
JOB_POLL_SECONDS="1"
JOB_HEARTBEAT_SECONDS="10"
JOB_STALE_AFTER_SECONDS="60"
JOB_MAX_ATTEMPTS="3"

# Клиент внешних моделей: live | mock | fixture.
#
# mock — умолчание и то, на чём идут тесты: детерминированный ответ без сети
# и без ключей, шаблон работает сразу после установки.
# fixture — записанный ответ с диска, backend/app/integrations/fixtures/.
# live — настоящий HTTP; нужны обе строки ниже. Пустые при live — отказ, а
# не тихий возврат к mock: иначе приложение отвечало бы выдумкой, считая это
# ответом модели.
#
# Поставщика шаблон не выбирает. Ожидается ответ вида {"answer": "..."};
# другую форму придётся разобрать в app/integrations/client.py.
INTEGRATIONS_MODE="mock"
INTEGRATIONS_URL=""
INTEGRATIONS_API_KEY=""
# Сколько ждать ответа, секунды. Если внешнюю модель зовут из ФОНОВОЙ
# ЗАДАЧИ, держи это значение меньше JOB_STALE_AFTER_SECONDS: задача,
# простоявшая на запросе дольше, считается брошенной, её берёт второй
# воркер — и один и тот же запрос уходит поставщику дважды, оплачиваясь
# тоже дважды.
INTEGRATIONS_TIMEOUT_SECONDS="30"
